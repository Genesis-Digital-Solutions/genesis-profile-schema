    "type": "select",
    "required": true,
    "options": [
     {
      "value": "yes",
      "label": {
       "pt": "Sim",
       "en": "Yes"
      }
     },
     {
      "value": "no",
      "label": {
       "pt": "Não",
       "en": "No"
      }
     }
    ]
   }
  ],
  "texts": {
   "privacy": {
    "title": {
     "pt": "Informação sobre dados pessoais",
     "en": "Personal data information"
    },
    "text": {
     "pt": "A [entidade] trata os dados pessoais deste questionário para [finalidade], com base em [fundamento]. Os dados são conservados durante [prazo] e podem ser comunicados a [destinatários], quando a lei o exija. Pode exercer os direitos de acesso, retificação, apagamento, limitação, portabilidade e oposição através de [contacto do encarregado de proteção de dados]. Tem também o direito de apresentar reclamação à autoridade de controlo.",
     "en": "[Entity] processes the personal data in this questionnaire for [purpose], on the basis of [legal basis]. The data is kept for [period] and may be disclosed to [recipients] where required by law. You may exercise your rights of access, rectification, erasure, restriction, portability and objection through [data protection officer contact]. You also have the right to lodge a complaint with the supervisory authority."
    }
   },
   "declaration": {
    "title": {
     "pt": "Declaração",
     "en": "Declaration"
    },
    "text": {
     "pt": "Declaro que as informações prestadas são verdadeiras, completas e atuais, e que comunicarei qualquer alteração.",
     "en": "I declare that the information provided is true, complete and up to date, and that I will report any change."
    }
   }
  }
 }
