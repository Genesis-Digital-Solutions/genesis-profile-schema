     {
      "value": "business",
      "label": {
       "pt": "Atividade empresarial",
       "en": "Business activity"
      }
     },
     {
      "value": "savings",
      "label": {
       "pt": "Poupanças",
       "en": "Savings"
      }
     },
     {
      "value": "inheritance",
      "label": {
       "pt": "Herança ou doação",
       "en": "Inheritance or gift"
      }
     },
     {
      "value": "other",
      "label": {
       "pt": "Outra",
       "en": "Other"
      }
     }
