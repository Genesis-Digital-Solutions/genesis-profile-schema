{
  "module": "review_queues",
  "case": "citizen_requests",
  "lang": "en",
  "key": "tickets",
  "item": {
    "states": [
      {
        "id": "new",
        "kind": "open",
        "label": "New"
      },
      {
        "id": "triaged",
        "kind": "parked",
        "label": "Triaged"
      },
      {
        "id": "in_progress",
        "kind": "parked",
        "label": "In progress"
      },
      {
        "id": "resolved",
        "kind": "final",
        "label": "Resolved"
      },
      {
        "id": "rejected",
        "kind": "final",
        "label": "Rejected"
      }
    ],
    "actions": [
      {
        "id": "triage",
        "from": [
          "new"
        ],
        "to": "triaged",
        "label": "Triage"
      },
      {
        "id": "start",
        "from": [
          "triaged"
        ],
        "to": "in_progress",
        "label": "Start"
      },
      {
        "id": "resolve",
        "from": [
          "triaged",
          "in_progress"
        ],
        "to": "resolved",
        "label": "Resolve"
      },
      {
        "id": "reject",
        "from": [
          "new",
          "triaged"
        ],
        "to": "rejected",
        "label": "Reject",
        "note_required": true
      }
    ],
    "label": "Citizen requests",
    "businessKey": {
      "prefix": "T"
    },
    "notifications": [
      {
        "when": "create",
        "channel": "sms",
        "to": "payload.citizen.telefone",
        "text": "Your request {business_key} was registered ({payload.category}). Keep this reference."
      },
      {
        "when": "resolve",
        "channel": "sms",
        "to": "payload.citizen.telefone",
        "text": "Your request {business_key} was resolved. Thank you for contacting us."
      }
    ]
  },
  "links": [
    "voice_phone"
  ],
  "features": {
    "reviewQueue": true
  },
  "human": []
}
